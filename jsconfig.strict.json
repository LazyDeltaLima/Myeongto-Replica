{
  // The folders checked with strict on (npm run typecheck ends with tools/typecheck-strict.mjs, which reads this
  // list). Their files are checked in each config that includes them (jsconfig.json, jsconfig.browser.json) with
  // strict added, and an error located in one of them fails; the rest of the program is checked strict as well but
  // only counted. Add a folder once `node tools/typecheck-strict.mjs --count` reports nothing for it: see
  // types/README.md "Strict". Run on its own (tsc -p jsconfig.strict.json) this also reports the files the listed
  // ones import, and with the server's options only.
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "types/*",
    "server/http/**/*.js",
    "public/js/i18n/**/*.js",
    "public/js/screens/game/**/*.js",
    "public/js/render/app/**/*.js",
    "public/js/battle/**/*.js",
    "public/js/debug/**/*.js",
    "public/js/ui/gameLogic/**/*.js",
    "shared/**/*.js",
    "server/*.js",
    "server/match/match/**/*.js",
    "server/match/player/**/*.js",
    "server/match/audit.js",
    "server/match/board.js",
    "server/match/bondsMeta.js",
    "server/match/bossPath.js",
    "server/match/botEmotes.js",
    "server/match/builtinMeta.js",
    "server/match/choices.js",
    "server/match/effectsMeta.js",
    "server/match/fields.js",
    "server/match/finalAssault.js",
    "server/match/gamedata.js",
    "server/match/invariants.js",
    "server/match/Match.js",
    "server/match/PlayerState.js",
    "server/match/pool.js",
    "server/match/preview.js",
    "server/match/results.js",
    "server/match/scheduler.js",
    "server/match/StubMatch.js",
    "server/match/unite.js",
    "server/match/unitTally.js",
    "server/match/waves.js"
  ],
  "exclude": []
}
