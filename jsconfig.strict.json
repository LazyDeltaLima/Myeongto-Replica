{
  // The folders checked with strict on (npm run typecheck ends with tools/typecheck-strict.mjs, which reads this
  // list). Their files are checked in each config that includes them (jsconfig.json, jsconfig.browser.json) with
  // strict added, and an error located in one of them fails; the rest of the program is checked strict as well but
  // only counted. Add a folder once `node tools/typecheck-strict.mjs --count` reports nothing for it: see
  // types/README.md "Strict". Run on its own (tsc -p jsconfig.strict.json) this also reports the files the listed
  // ones import, and with the server's options only.
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "types/*",
    "server/http/**/*.js",
    "public/js/i18n/**/*.js",
    "public/js/screens/game/**/*.js",
    "public/js/render/app/**/*.js",
    "public/js/battle/**/*.js",
    "public/js/debug/**/*.js",
    "public/js/ui/gameLogic/**/*.js",
    "shared/**/*.js",
    "server/*.js",
    "server/match/match/**/*.js",
    "server/match/player/**/*.js",
    "server/match/*.js",
    "server/sim/content/kits/*.js",
    "server/sim/content/garrisons/**/*.js",
    "server/sim/content/support/**/*.js",
    "server/sim/content/bonds/**/*.js",
    "server/sim/content/items/**/*.js",
    "server/sim/content/bands/**/*.js",
    "server/sim/content/kits/shared/**/*.js",
    "server/sim/battle/**/*.js",
    "server/sim/*.js",
    "server/sim/content/*.js",
    "server/sim/content/enemies/**/*.js",
    "server/sim/content/kits/ops/**/*.js",
    "public/js/render/board3d/**/*.js",
    "public/js/render/fx/**/*.js",
    "public/js/*.js",
    "public/js/screens/*.js",
    // the files directly under public/js/ui/ one by one, until the whole folder is clean (public/js/ui/*.js)
    "public/js/ui/abilityLines.js",
    "public/js/ui/about.js",
    "public/js/ui/allianceScene.js",
    "public/js/ui/allyArt.js",
    "public/js/ui/assetUrls.js",
    "public/js/ui/avatarBadges.js",
    "public/js/ui/chat.js",
    "public/js/ui/chatTime.js",
    "public/js/ui/clipboard.js",
    "public/js/ui/compat.js",
    "public/js/ui/components.js",
    "public/js/ui/connBanner.js",
    "public/js/ui/customRules.js",
    "public/js/ui/customRulesStore.js",
    "public/js/ui/customSummary.js",
    "public/js/ui/detailPanel.js",
    "public/js/ui/device.js",
    "public/js/ui/diyCard.js",
    "public/js/ui/diyModel.js",
    "public/js/ui/diyPresets.js",
    "public/js/ui/emotes.js",
    "public/js/ui/faction.js",
    "public/js/ui/factionPick.js",
    "public/js/ui/feedback.js",
    "public/js/ui/fieldHost.js",
    "public/js/ui/fitLine.js",
    "public/js/ui/gameActions.js",
    "public/js/ui/gameComponents.js",
    "public/js/ui/gameLogic.js",
    "public/js/ui/generation.js",
    "public/js/ui/gpuNotice.js",
    "public/js/ui/guide.js",
    "public/js/ui/hud.js",
    "public/js/ui/inviteSpectate.js",
    "public/js/ui/lang.js",
    "public/js/ui/level.js",
    "public/js/ui/loadoutModel.js",
    "public/js/ui/loadoutSync.js",
    "public/js/ui/matchChrome.js",
    "public/js/ui/matchInfo.js",
    "public/js/ui/matchIntel.js",
    "public/js/ui/matchQueue.js",
    "public/js/ui/matchToast.js",
    "public/js/ui/numberStyleSetting.js",
    "public/js/ui/patchNotes.js",
    "public/js/ui/protocolBoot.js",
    "public/js/ui/protocolScene.js",
    "public/js/ui/publicRooms.js",
    "public/js/ui/restartNotice.js",
    "public/js/ui/resumeMatch.js",
    "public/js/ui/rewardOverlay.js",
    "public/js/ui/richText.js",
    "public/js/ui/ruleset.js",
    "public/js/ui/season.js",
    "public/js/ui/seasonArt.js",
    "public/js/ui/seasonFade.js",
    "public/js/ui/seasonRays.js",
    "public/js/ui/seatArt.js",
    "public/js/ui/seatCards.js",
    "public/js/ui/settings.js",
    "public/js/ui/skinPicker.js",
    "public/js/ui/skins.js",
    "public/js/ui/spectators.js",
    "public/js/ui/tileToast.js",
    "public/js/ui/titleHexagon.js",
    "public/js/ui/toasts.js",
    "public/js/ui/updateNotice.js"
  ],
  "exclude": []
}
