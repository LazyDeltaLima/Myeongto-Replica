{
  // The folders checked with strict on (npm run typecheck ends with tools/typecheck-strict.mjs, which reads this
  // list). Their files are checked in each config that includes them (jsconfig.json, jsconfig.browser.json) with
  // strict added, and an error located in one of them fails; the rest of the program is checked strict as well but
  // only counted. Add a folder once `node tools/typecheck-strict.mjs --count` reports nothing for it: see
  // types/README.md "Strict". Run on its own (tsc -p jsconfig.strict.json) this also reports the files the listed
  // ones import, and with the server's options only.
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "types/*",
    "server/http/**/*.js",
    "public/js/i18n/**/*.js",
    "public/js/screens/game/**/*.js",
    "public/js/render/app/**/*.js",
    "public/js/battle/**/*.js",
    "public/js/debug/**/*.js",
    "public/js/ui/gameLogic/**/*.js",
    "shared/**/*.js",
    "server/*.js",
    "server/match/match/**/*.js",
    "server/match/player/**/*.js",
    "server/match/*.js",
    "server/sim/content/kits/*.js",
    "server/sim/content/garrisons/**/*.js",
    "server/sim/content/support/**/*.js",
    "server/sim/content/bonds/**/*.js",
    "server/sim/content/items/**/*.js",
    "server/sim/content/bands/**/*.js",
    "server/sim/content/kits/shared/**/*.js",
    "server/sim/battle/**/*.js",
    "server/sim/*.js",
    "server/sim/content/*.js",
    "server/sim/content/enemies/**/*.js",
    "server/sim/content/kits/ops/**/*.js",
    "public/js/render/board3d/**/*.js",
    "public/js/render/fx/**/*.js",
    "public/js/render/auto-quality.js",
    "public/js/render/boardArt.js",
    "public/js/render/drag.js",
    "public/js/render/elite-mark.js",
    "public/js/render/face-turn.js",
    "public/js/render/facing.js",
    "public/js/render/heldWheel.js",
    "public/js/render/home-mark.js",
    "public/js/render/impostor.js",
    "public/js/render/infectionMark.js",
    "public/js/render/interp.js",
    "public/js/render/item-models.js",
    "public/js/render/load-level.js",
    "public/js/render/num-official.js",
    "public/js/render/number-style.js",
    "public/js/render/pen.js",
    "public/js/render/pick.js",
    "public/js/render/prepfield.js",
    "public/js/render/projection.js",
    "public/js/render/promote.js",
    "public/js/render/skin-gate.js",
    "public/js/render/spine.js",
    "public/js/render/style.js",
    "public/js/render/tiles.js",
    "public/js/*.js",
    "public/js/screens/*.js",
    "public/js/ui/*.js"
  ],
  "exclude": []
}
