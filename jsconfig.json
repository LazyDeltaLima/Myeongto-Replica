{
  // Server typecheck (npm run typecheck runs this and jsconfig.browser.json). strict stays off until a folder is clean.
  // tsc does not load this file unless invoked with -p jsconfig.json.
  // Widen one path at a time: see types/README.md.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "shared/**/*.js",
    "server/**/*.js",
    "types/**/*.js",
    "types/sim-members.d.ts",
    "types/class-members.d.ts"
  ],
  "exclude": [
    "shared/bandBonds.js"
  ]
}
