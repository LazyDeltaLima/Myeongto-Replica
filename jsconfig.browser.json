{
  // Browser typecheck: what the page loads, checked with the DOM and without the Node types (npm run typecheck runs
  // this after jsconfig.json). shared/ and the sim files run in the page as well, so they are checked here too.
  // The vendored modules are read through the declarations tools/vendor.mjs puts beside them (types/vendor/), the
  // script-tag globals through types/page-globals.d.ts. Widen one path at a time: see types/README.md.
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // the debug arena imports the sim by URL (types/sim-url.d.ts)
    "paths": {
      "/sim/dir.js": ["./server/sim/dir.js"],
      "/sim/*": ["./types/sim-url.d.ts"]
    }
  },
  "include": [
    "shared/**/*.js",
    "server/sim/rng.js",
    "server/sim/detmath.js",
    "server/sim/dir.js",
    "server/sim/constants.js",
    "public/js/**/*.js",
    "types/**/*.js",
    "types/page-members.d.ts",
    "types/page-globals.d.ts"
  ]
}
